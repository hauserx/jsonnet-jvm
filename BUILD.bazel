java_junit5_test(
    name = "ArrayBuilderTest",
    jvm_flags = _TEST_JVM_FLAGS,
    test_class = "com.databricks.jsonnetjvm.runtime.ArrayBuilderTest",
    runtime_deps = [":test_lib"],
