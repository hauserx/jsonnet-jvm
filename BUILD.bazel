java_junit5_test(
    name = "JsonnetJsonTest",
    jvm_flags = _TEST_JVM_FLAGS,
    test_class = "com.databricks.jsonnetjvm.runtime.JsonnetJsonTest",
    runtime_deps = [":test_lib"],
