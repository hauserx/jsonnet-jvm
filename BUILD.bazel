load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_plugin")
load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")

# ---------------------------------------------------------------------------
# Annotation processors
# ---------------------------------------------------------------------------

java_plugin(
    name = "truffle_dsl_processor_plugin",
    generates_api = False,
    processor_class = "com.oracle.truffle.dsl.processor.TruffleProcessor",
    deps = ["@maven//:org_graalvm_truffle_truffle_dsl_processor"],
)

java_plugin(
    name = "picocli_codegen_plugin",
    generates_api = False,
    processor_class = "picocli.codegen.aot.graalvm.processor.NativeImageConfigGeneratorProcessor",
    deps = ["@maven//:info_picocli_picocli_codegen"],
)

# ---------------------------------------------------------------------------
# ANTLR source generation
# ---------------------------------------------------------------------------

genrule(
    name = "antlr_generate",
    srcs = ["src/main/antlr/com/databricks/jsonnetjvm/Jsonnet.g4"],
    outs = [
        "JsonnetBaseListener.java",
        "JsonnetBaseVisitor.java",
        "JsonnetLexer.java",
        "JsonnetListener.java",
        "JsonnetParser.java",
        "JsonnetVisitor.java",
    ],
    cmd = "TMPOUT=$$(mktemp -d) && java -jar $(location @antlr4_tool//file) -o $$TMPOUT -package com.databricks.jsonnetjvm -listener -visitor $(location src/main/antlr/com/databricks/jsonnetjvm/Jsonnet.g4) && mv $$TMPOUT/src/main/antlr/com/databricks/jsonnetjvm/*.java $(@D)/",
    tools = ["@antlr4_tool//file"],
)

java_library(
    name = "antlr_generated",
    srcs = [":antlr_generate"],
    deps = ["@maven//:org_antlr_antlr4_runtime"],
)

# ---------------------------------------------------------------------------
# Main library
# ---------------------------------------------------------------------------

java_library(
    name = "jsonnet_jvm_lib",
    srcs = glob([
        "src/main/java/**/*.java",
        # JsonnetLanguageProvider is generated by truffle-dsl-processor but requires
        # GraalVM JDK to generate; committed here so any JDK 25 can build.
        "src/main/generated/truffle/**/*.java",
    ]),
    plugins = [
        ":truffle_dsl_processor_plugin",
        ":picocli_codegen_plugin",
    ],
    resource_strip_prefix = "src/main/resources",
    resources = glob(["src/main/resources/**"]),
    deps = [
        ":antlr_generated",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_re2j_re2j",
        "@maven//:info_picocli_picocli",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_graalvm_polyglot_polyglot",
        "@maven//:org_graalvm_sdk_graal_sdk",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_tukaani_xz",
        "@maven//:org_yaml_snakeyaml",
    ],
    runtime_deps = [
        "@maven//:org_graalvm_truffle_truffle_compiler",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

# ---------------------------------------------------------------------------
# Executable binary
# ---------------------------------------------------------------------------

java_binary(
    name = "jsonnet_jvm",
    jvm_flags = [
        "-Xmx2g",
        "-XX:+UnlockExperimentalVMOptions",
        "-XX:+EnableJVMCI",
        "-Dpolyglot.engine.WarnInterpreterOnly=true",
        "--enable-native-access=ALL-UNNAMED",
        "--sun-misc-unsafe-memory-access=allow",
    ],
    main_class = "com.databricks.jsonnetjvm.Main",
    runtime_deps = [":jsonnet_jvm_lib"],
)

# ---------------------------------------------------------------------------
# Native image
# ---------------------------------------------------------------------------

# Build a deploy jar first (all deps bundled), then compile to native binary.
# Using a genrule to invoke native-image directly avoids rules_graalvm Bazel 9
# compatibility issues with cc_common.configure_features.
genrule(
    name = "jsonnet_jvm_native",
    srcs = [
        ":jsonnet_jvm_deploy.jar",
        # All GraalVM SDK/Truffle jars that declare ForceOnModulePath must be
        # provided on the module path as proper modular JARs (module-info.class).
        # The deploy jar merges them as flat classes, losing module structure.
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_graalvm_truffle_truffle_compiler",
        "@maven//:org_graalvm_truffle_truffle_runtime",
        "@maven//:org_graalvm_sdk_graal_sdk",
        "@maven//:org_graalvm_sdk_collections",
        "@maven//:org_graalvm_sdk_jniutils",
        "@maven//:org_graalvm_sdk_nativeimage",
        "@maven//:org_graalvm_sdk_word",
        "@maven//:org_graalvm_polyglot_polyglot",
    ],
    outs = ["jsonnet_jvm_native-bin"],
    tools = ["@graalvm//:bin-native-image"],
    cmd = """
        MODPATH=$(location @maven//:org_graalvm_truffle_truffle_api):$(location @maven//:org_graalvm_truffle_truffle_compiler):$(location @maven//:org_graalvm_truffle_truffle_runtime):$(location @maven//:org_graalvm_sdk_graal_sdk):$(location @maven//:org_graalvm_sdk_collections):$(location @maven//:org_graalvm_sdk_jniutils):$(location @maven//:org_graalvm_sdk_nativeimage):$(location @maven//:org_graalvm_sdk_word):$(location @maven//:org_graalvm_polyglot_polyglot)
        $(location @graalvm//:bin-native-image) \
            --no-fallback \
            -O3 \
            --enable-native-access=ALL-UNNAMED \
            -H:+ReportExceptionStackTraces \
            -H:+AllowDeprecatedBuilderClassesOnImageClasspath \
            --initialize-at-build-time=com.databricks.jsonnetjvm,com.google.re2j,com.fasterxml.jackson \
            --module-path $$MODPATH \
            -cp $(location :jsonnet_jvm_deploy.jar) \
            --exclude-config ".*deploy.*" "META-INF/native-image/org.graalvm\\..*" \
            -H:Name=$(RULEDIR)/jsonnet_jvm_native-bin \
            com.databricks.jsonnetjvm.Main
    """,
    executable = True,
)

# ---------------------------------------------------------------------------
# Test infrastructure
# ---------------------------------------------------------------------------

_TEST_JVM_FLAGS = [
    "-Xmx2g",
    "-XX:+UnlockExperimentalVMOptions",
    "-XX:+EnableJVMCI",
    "-Dpolyglot.engine.WarnInterpreterOnly=false",
    "--enable-native-access=ALL-UNNAMED",
    "--sun-misc-unsafe-memory-access=allow",
]

java_library(
    name = "test_lib",
    testonly = True,
    srcs = glob(["src/test/java/**/*.java"]),
    deps = [
        ":antlr_generated",
        ":jsonnet_jvm_lib",
        "@maven//:info_picocli_picocli",
        "@maven//:org_graalvm_sdk_graal_sdk",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
    ],
    runtime_deps = [
        "@maven//:org_graalvm_truffle_truffle_compiler",
        "@maven//:org_graalvm_truffle_truffle_runtime",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
)

# ---------------------------------------------------------------------------
# Test targets (one per class)
# ---------------------------------------------------------------------------

java_junit5_test(
    name = "IntegrationTest",
    data = [
        "@sjsonnet_tests//:cpp_test_suite",
        "@sjsonnet_tests//:test_suite/arith_bool.jsonnet",
        "@go_jsonnet_tests//:testdata",
        "@go_jsonnet_tests//:array.jsonnet",
    ] + glob([
        "src/test/resources/cpp_test_suite_local/**",
        "src/test/resources/go_jsonnet_tests_local/**",
        "src/test/resources/new_test_suite/**",
    ]),
    env = {
        "CPP_TEST_SUITE_RLOC": "$(rlocationpath @sjsonnet_tests//:test_suite/arith_bool.jsonnet)",
        "GO_JSONNET_TESTS_RLOC": "$(rlocationpath @go_jsonnet_tests//:array.jsonnet)",
    },
    jvm_flags = _TEST_JVM_FLAGS,
    test_class = "com.databricks.jsonnetjvm.IntegrationTest",
    runtime_deps = [":test_lib"],
)

