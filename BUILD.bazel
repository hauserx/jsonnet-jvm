test_suite(
    name = "all_tests",
    tests = [
        ":ArrayBuilderTest",
        ":DecimalFormatTest",
        ":EncodingTest",
        ":IntegrationTest",
        ":JObjectTest",
        ":JsonnetEvaluatorTest",
        ":JsonnetJsonTest",
        ":JsonnetStringsTest",
        ":ManifestTest",
        ":NativeRegexTest",
        ":ParserTest",
        ":StdFormatTest",
    ],
)
