java_junit5_test(
    name = "NativeRegexTest",
    jvm_flags = _TEST_JVM_FLAGS,
    test_class = "com.databricks.jsonnetjvm.stdlib.NativeRegexTest",
    runtime_deps = [":test_lib"],
