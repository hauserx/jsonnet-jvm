java_junit5_test(
    name = "JsonnetStringsTest",
    jvm_flags = _TEST_JVM_FLAGS,
    test_class = "com.databricks.jsonnetjvm.runtime.JsonnetStringsTest",
    runtime_deps = [":test_lib"],
)

java_junit5_test(
    name = "DecimalFormatTest",
    jvm_flags = _TEST_JVM_FLAGS,
    test_class = "com.databricks.jsonnetjvm.stdlib.DecimalFormatTest",
    runtime_deps = [":test_lib"],
